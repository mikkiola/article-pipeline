#!/usr/bin/env bash
# Integrated ToolTempest DocOps Protocol (Canon: ToolTempest ADR-0001)
# Pinned version in .tooltempest.lock
#
# Checks the staged index (not the working tree) with scripts/docops.py, the
# vendored ToolTempest DocOps checker. GIT_INDEX_FILE is inherited on purpose:
# git sets it for `git commit -a` and `git commit <path>`, so the checker sees
# exactly the tree that will be committed. Any non-zero checker exit blocks the
# commit (fail-closed): 1 = invariant violated, 2 = no verdict. The SPEC.md scope
# rule is the checker's own contract (ToolTempest ADR-0013 Decision 7);
# `scripts/docops.py check --help` lists its exit codes.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "[pre-commit] Running DocOps check on the staged index (scripts/docops.py check --tree index)..."
rc=0
output="$(python3 scripts/docops.py check --tree index 2>&1)" || rc=$?
if [ "$rc" -ne 0 ]; then
  printf '%s\n' "$output"
  echo "[pre-commit] FAIL: DocOps check exited $rc (1 = invariant violated, 2 = no verdict). Commit blocked."
  exit "$rc"
fi
echo "[pre-commit] DocOps check passed."
