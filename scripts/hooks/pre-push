#!/usr/bin/env bash
# Integrated ToolTempest DocOps Protocol (Canon: ToolTempest ADR-0001)
# Pinned version in .tooltempest.lock
#
# DocOps check: scripts/docops.py inspects each pushed local OID (not HEAD), read
# from git's pre-push stdin; a deleted ref (all-zero OID) has nothing to check.
# SPEC.md scope: only the root SPEC.md, or the tracks registered in
# .docops-policy.json, are evaluated; a SPEC.md in a subfolder must be
# registered there. An unregistered one yields SKIP (exit 3) when no registered
# SPEC is active, and any non-zero exit blocks the push (fail-closed). Beside an
# active registered SPEC it does not block: the check passes and the hook prints
# an OUT_OF_SCOPE_SPEC warning, so the unevaluated SPEC.md is not silently ignored.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Read every ref-update line first, so no later command can consume stdin.
push_stdin="$(cat)"

fail=0

if ! bash scripts/check-adr-citation.sh; then
  fail=1
fi

echo "[pre-push] Running gitleaks..."
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks detect --source . --no-git -v; then
    echo "[pre-push] FAIL: gitleaks found a potential secret."
    fail=1
  fi
else
  echo "[pre-push] WARNING: gitleaks not installed, skipping secret scan."
fi

# git also runs this hook for an up-to-date push, with empty stdin: no commit
# leaves the repository then, so there is nothing for DocOps to check.
if [ -z "$push_stdin" ]; then
  echo "[pre-push] No ref updates to push; skipping the DocOps check."
else
  echo "[pre-push] Running DocOps check on the pushed commits (scripts/docops.py check --push-stdin)..."
  rc=0
  output="$(printf '%s\n' "$push_stdin" | python3 scripts/docops.py check --push-stdin 2>&1)" || rc=$?
  if [ "$rc" -ne 0 ]; then
    printf '%s\n' "$output"
    echo "[pre-push] FAIL: DocOps check exited $rc (1 = invariant violated, 2 = no verdict, 3 = SPEC applicability not established)."
    fail=1
  else
    echo "[pre-push] DocOps check passed."
    # Display only: a passing check can still carry OUT_OF_SCOPE_SPEC warnings. The
    # trailing `|| true` keeps this step from ever changing the hook's exit status.
    printf '%s\n' "$push_stdin" | python3 scripts/docops.py report --push-stdin 2>/dev/null \
      | grep -F 'warning OUT_OF_SCOPE_SPEC' | sed 's/^ *warning /[pre-push] WARNING: /' || true
  fi
fi

bash scripts/check-doc-pairing.sh

if [ "$fail" -eq 1 ]; then
  echo "[pre-push] Push blocked. Fix the FAIL items above and try again."
  exit 1
fi

echo "[pre-push] All hard checks passed."
exit 0
