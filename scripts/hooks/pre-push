#!/usr/bin/env bash
# Integrated ToolTempest DocOps Protocol (Canon: ToolTempest ADR-0001)
# Pinned version in .tooltempest.lock
#
# DocOps check: scripts/docops.py inspects each pushed local OID (not HEAD), read
# from git's pre-push stdin; a deleted ref (all-zero OID) has nothing to check.
# Any non-zero checker exit blocks the push (fail-closed): 1 = invariant
# violated, 2 = no verdict. The SPEC.md scope rule is the checker's own contract
# (ToolTempest ADR-0013 Decision 7); `scripts/docops.py check --help` lists its
# exit codes.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Read every ref-update line first, so no later command can consume stdin.
push_stdin="$(cat)"

# ToolTempest pin check (ToolTempest ADR-0022, Decision 5): runs first, before
# every other check and before the pinned checker is executed. Any non-zero
# exit blocks the push at once: 1 = blocked, 2 = usage or internal failure (also
# when scripts/tt_pin_check.py is missing, which is fail-closed: run
# scripts/tooling.py materialize first). An empty stdin (an up-to-date push)
# has nothing to check and passes.
echo "[pre-push] Running the ToolTempest pin check (scripts/tt_pin_check.py push)..."
pin_rc=0
printf '%s\n' "$push_stdin" | python3 scripts/tt_pin_check.py push --root "$REPO_ROOT" || pin_rc=$?
if [ "$pin_rc" -ne 0 ]; then
  echo "[pre-push] FAIL: pin check exited $pin_rc (1 = blocked, 2 = usage or internal failure). Push blocked."
  exit "$pin_rc"
fi

fail=0

if ! bash scripts/check-adr-citation.sh; then
  fail=1
fi

echo "[pre-push] Running gitleaks..."
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks detect --source . --no-git -v; then
    echo "[pre-push] FAIL: gitleaks found a potential secret."
    fail=1
  fi
else
  echo "[pre-push] WARNING: gitleaks not installed, skipping secret scan."
fi

# git also runs this hook for an up-to-date push, with empty stdin: no commit
# leaves the repository then, so there is nothing for DocOps to check.
if [ -z "$push_stdin" ]; then
  echo "[pre-push] No ref updates to push; skipping the DocOps check."
else
  echo "[pre-push] Running DocOps check on the pushed commits (scripts/docops.py check --push-stdin)..."
  rc=0
  output="$(printf '%s\n' "$push_stdin" | python3 scripts/docops.py check --push-stdin 2>&1)" || rc=$?
  if [ "$rc" -ne 0 ]; then
    printf '%s\n' "$output"
    echo "[pre-push] FAIL: DocOps check exited $rc (1 = invariant violated, 2 = no verdict)."
    fail=1
  else
    echo "[pre-push] DocOps check passed."
  fi
fi

bash scripts/check-doc-pairing.sh

if [ "$fail" -eq 1 ]; then
  echo "[pre-push] Push blocked. Fix the FAIL items above and try again."
  exit 1
fi

echo "[pre-push] All hard checks passed."
exit 0
