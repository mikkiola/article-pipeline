#!/usr/bin/env bash
# Integrated ToolTempest DocOps Protocol (Canon: ToolTempest ADR-0001)
# Pinned version in .tooltempest.lock
#
# DocOps check: scripts/docops.py inspects each pushed local OID (not HEAD), read
# from git's pre-push stdin; a deleted ref (all-zero OID) has nothing to check.
# Any non-zero checker exit blocks the push (fail-closed): 1 = invariant
# violated, 2 = no verdict. The SPEC.md scope rule is the checker's own contract
# (ToolTempest ADR-0013 Decision 7); `scripts/docops.py check --help` lists its
# exit codes.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Read every ref-update line first, so no later command can consume stdin.
push_stdin="$(cat)"

# ToolTempest pin check (ToolTempest ADR-0022, Decision 5): runs first, before
# every other check and before the pinned checker is executed. Any non-zero
# exit blocks the push at once: 1 = blocked, 2 = usage or internal failure (also
# when scripts/tt_pin_check.py is missing, which is fail-closed: run
# scripts/tooling.py materialize first). An empty stdin (an up-to-date push)
# has nothing to check and passes.
echo "[pre-push] Running the ToolTempest pin check (scripts/tt_pin_check.py push)..."
pin_rc=0
printf '%s\n' "$push_stdin" | python3 scripts/tt_pin_check.py push --root "$REPO_ROOT" || pin_rc=$?
if [ "$pin_rc" -ne 0 ]; then
  echo "[pre-push] FAIL: pin check exited $pin_rc (1 = blocked, 2 = usage or internal failure). Push blocked."
  exit "$pin_rc"
fi

fail=0

if ! bash scripts/check-adr-citation.sh; then
  fail=1
fi

echo "[pre-push] Running gitleaks on the commits this push publishes..."
# Secret scan of the commits each pushed ref adds on the remote side, not of the
# working tree: a secret that one pushed commit adds and a later one removes is
# found, published history is not rescanned. A scan that cannot complete (no
# scanner, scanner error, git error, undeterminable range) blocks the push.
# Exit codes of gitleaks: 0 clean, 2 secret found (--exit-code), other = failed.
# --redact: the output prints no secret value. A false positive is silenced by the
# scanner's own mechanisms (.gitleaksignore fingerprint, `gitleaks:allow` comment).
# --remerge-diff makes git show what a merge commit itself adds; without it
# `git log -p` shows no diff for merges. It needs git >= 2.36: an older git
# blocks the push with a message that names the minimum version.
# --text and --no-textconv make git print the bytes of every file: without them an
# attribute (-diff, binary), a NUL byte in a file or a textconv driver replaces the
# diff by a placeholder or a converted text, and gitleaks scans none of those bytes.
# gitleaks treats any stderr output of its own `git log` call as a failed read: it
# logs `ERR error="stderr is not empty"`, reports "0 commits scanned" and exits 0.
# So the git trace variables (GIT_TRACE*) are removed from its environment, and an
# ERR line in its log blocks the push even at exit 0 (a git warning does the same).
# The same goes for every GITLEAKS_* variable: gitleaks reads its options from them
# (a config file, an inline config), and the repository's .gitleaks.toml decides.
# The ERR line is searched with bash's own matcher, not an external command: only
# "no match" passes, any other status blocks.
# The number of commits scanned is not checked: gitleaks reports 0 for commits
# that add no text (delete-only, empty, mode-only, rename-only, empty file).
# Known limits of this scan: docs/adr/0077-pre-push-secret-scan-covers-the-commits-a-push-publishes.md.
# $1 is the remote name, or the URL itself for a push by URL. A URL may carry
# credentials, so it is never printed or passed on: it is mapped to a configured
# remote by its push URL, and an unmapped URL blocks.
scan_remote="${1:-}"
scan_target_ok=1
if [ -z "$scan_remote" ]; then
  scan_target_ok=0
else
  # Plain string matching on captured output: no `grep -q` in a pipe, which
  # under pipefail can report a match as a failure (SIGPIPE to the producer).
  scan_nl=$'\n'
  scan_names="$(git remote)"
  if [[ "$scan_nl$scan_names$scan_nl" != *"$scan_nl$scan_remote$scan_nl"* ]]; then
    scan_mapped=""
    for s_n in $scan_names; do
      s_urls="$(git remote get-url --push --all "$s_n" 2>/dev/null)" || s_urls=""
      if [[ "$scan_nl$s_urls$scan_nl" == *"$scan_nl$scan_remote$scan_nl"* ]]; then
        scan_mapped="$s_n"
        break
      fi
    done
    scan_remote="$scan_mapped"
    [ -n "$scan_remote" ] || scan_target_ok=0
  fi
fi
scan_zero='^0+$'
s_err_re='(^|[[:space:]])ERR[[:space:]]'
if [ -z "$push_stdin" ]; then
  echo "[pre-push] No ref updates to push; nothing to scan for secrets."
fi
while read -r s_lref s_loid s_rref s_roid; do
  [ -n "$s_lref" ] || continue
  if [ -z "$s_roid" ]; then
    echo "[pre-push] FAIL: secret scan cannot determine the range of '$s_lref' (incomplete pre-push input)."
    echo "[pre-push] Recovery: push with 'git push <remote> <ref>' from a normal git invocation."
    fail=1
    continue
  fi
  if [[ "$s_loid" =~ $scan_zero ]]; then
    echo "[pre-push] $s_rref: deletion, no commit is published; nothing to scan."
    continue
  fi
  if [ "$scan_target_ok" -ne 1 ]; then
    echo "[pre-push] FAIL: secret scan cannot determine what is already published for $s_rref: the push target is not a configured remote (a push by URL, or no remote name)."
    echo "[pre-push] Recovery: push by remote name: git push <remote> <ref>   (git remote -v lists the names)"
    fail=1
    continue
  fi
  if ! git rev-parse --verify --quiet "${s_loid}^{commit}" >/dev/null; then
    echo "[pre-push] FAIL: secret scan cannot read $s_lref ($s_loid) as a commit; its commits are not scanned."
    echo "[pre-push] Recovery: a ref that points to a tree or blob cannot be scanned; push a ref that points to a commit."
    fail=1
    continue
  fi
  if [[ "$s_roid" =~ $scan_zero ]]; then
    # New ref: every commit not reachable from a remote-tracking ref of this remote.
    s_revs=("$s_loid" --not "--remotes=$scan_remote")
  elif git rev-parse --verify --quiet "${s_roid}^{commit}" >/dev/null; then
    # Existing ref (update or force push): what the push adds on top of the remote tip.
    s_revs=("${s_roid}..${s_loid}")
  else
    echo "[pre-push] FAIL: secret scan cannot determine the new commits of $s_rref: remote tip $s_roid is not a commit in this repository."
    echo "[pre-push] Recovery: git fetch $scan_remote   (then push again)"
    fail=1
    continue
  fi
  if ! s_count="$(git rev-list --count "${s_revs[@]}" 2>/dev/null)"; then
    echo "[pre-push] FAIL: secret scan: git could not resolve the commit range '${s_revs[*]}' for $s_rref."
    echo "[pre-push] Recovery: git fetch $scan_remote   (then push again); if it persists, run 'git rev-list ${s_revs[*]}' to see the git error."
    fail=1
    continue
  fi
  if [ "$s_count" -eq 0 ]; then
    echo "[pre-push] $s_rref: no new commits to scan."
    continue
  fi
  if ! command -v gitleaks >/dev/null 2>&1; then
    echo "[pre-push] FAIL: secret scan did not run: gitleaks is not installed; $s_count commit(s) of $s_rref are not scanned."
    echo "[pre-push] Recovery: brew install gitleaks   (then push again)"
    fail=1
    continue
  fi
  # Probe of the option only: -n 0 parses the options and the commit but computes no
  # diff. The minimum-version message is printed only when git names the option as
  # unrecognized; any other failure gets its own message.
  s_probe_rc=0
  s_probe_err="$(git log --remerge-diff -n 0 --format=%H "$s_loid" 2>&1 >/dev/null)" || s_probe_rc=$?
  if [ "$s_probe_rc" -ne 0 ]; then
    if [[ "$s_probe_err" == *remerge-diff* ]]; then
      echo "[pre-push] FAIL: secret scan did not run: this git ($(git --version 2>/dev/null || echo 'version unknown')) does not support 'git log --remerge-diff'; $s_count commit(s) of $s_rref are not scanned."
      echo "[pre-push] Recovery: install git 2.36 or newer (brew upgrade git), then push again."
    else
      echo "[pre-push] FAIL: secret scan did not run: git could not read $s_lref ($s_loid) for the scan (exit $s_probe_rc); $s_count commit(s) of $s_rref are not scanned."
      echo "[pre-push] Recovery: run  git log --remerge-diff -n 0 $s_loid  and fix the git error shown; for an incomplete clone: git fetch $scan_remote"
    fi
    fail=1
    continue
  fi
  s_logopts="--remerge-diff --text --no-textconv ${s_revs[*]}"
  echo "[pre-push] $s_rref: scanning $s_count new commit(s) (git log $s_logopts)."
  s_unset=()
  for s_v in $(compgen -v GIT_TRACE) $(compgen -v GITLEAKS_); do s_unset+=(-u "$s_v"); done
  s_rc=0
  s_out="$(env ${s_unset[@]+"${s_unset[@]}"} gitleaks detect --source . --log-opts "$s_logopts" -v --redact --exit-code 2 --no-color </dev/null 2>&1)" || s_rc=$?
  printf '%s\n' "$s_out"
  if [ "$s_rc" -eq 0 ]; then
    s_err_rc=0
    [[ "$s_out" =~ $s_err_re ]] || s_err_rc=$?
    if [ "$s_err_rc" -eq 0 ]; then
      echo "[pre-push] FAIL: secret scan for $s_rref is not trusted: gitleaks logged an error (ERR line above) although it exited 0; its commits may not have been scanned."
      echo "[pre-push] Recovery: run  git log -p -U0 $s_logopts >/dev/null  and fix what git prints on stderr (a warning counts), then push again."
      fail=1
    elif [ "$s_err_rc" -ne 1 ]; then
      echo "[pre-push] FAIL: secret scan for $s_rref is not trusted: its log could not be searched for an error line (match status $s_err_rc); its commits may not have been scanned."
      echo "[pre-push] Recovery: push again; if it persists, run  gitleaks detect --source . --log-opts '$s_logopts' -v --redact  and read its log for ERR lines."
      fail=1
    fi
    continue
  elif [ "$s_rc" -eq 2 ] && grep -Eq 'leaks found: [1-9]' <<< "$s_out"; then
    echo "[pre-push] FAIL: gitleaks found a potential secret in the commits pushed to $s_rref (see the File and Fingerprint lines above, the Fingerprint starts with the commit; values are redacted)."
    echo "[pre-push] Recovery: remove the secret from those commits (rewrite them, e.g. git rebase -i) and rotate it if it was real."
    echo "[pre-push]   A false positive: add its Fingerprint to .gitleaksignore, or put a 'gitleaks:allow' comment on the line."
  else
    echo "[pre-push] FAIL: secret scan did not complete for $s_rref (gitleaks exit $s_rc); its commits are not scanned."
    echo "[pre-push] Recovery: run  gitleaks detect --source . --log-opts '$s_logopts' -v --redact  and fix the error shown."
  fi
  fail=1
done <<< "$push_stdin"

# git also runs this hook for an up-to-date push, with empty stdin: no commit
# leaves the repository then, so there is nothing for DocOps to check.
if [ -z "$push_stdin" ]; then
  echo "[pre-push] No ref updates to push; skipping the DocOps check."
else
  echo "[pre-push] Running DocOps check on the pushed commits (scripts/docops.py check --push-stdin)..."
  rc=0
  output="$(printf '%s\n' "$push_stdin" | python3 scripts/docops.py check --push-stdin 2>&1)" || rc=$?
  if [ "$rc" -ne 0 ]; then
    printf '%s\n' "$output"
    echo "[pre-push] FAIL: DocOps check exited $rc (1 = invariant violated, 2 = no verdict)."
    fail=1
  else
    echo "[pre-push] DocOps check passed."
  fi
fi

bash scripts/check-doc-pairing.sh

if [ "$fail" -eq 1 ]; then
  echo "[pre-push] Push blocked. Fix the FAIL items above and try again."
  exit 1
fi

echo "[pre-push] All hard checks passed."
exit 0
